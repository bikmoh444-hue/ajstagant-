# Copier vers .env.local et utiliser les valeurs du projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Serveur uniquement : ne jamais préfixer cette clé par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
NEXT_PUBLIC_SITE_URL=https://your-site.example
CONTACT_PUBLIC_ORIGIN=https://your-site.example
CONTACT_STORAGE_MODE=supabase
# Activer uniquement derrière un proxy qui remplace les en-têtes IP clients.
CONTACT_TRUST_PROXY=false
CONTACT_RATE_LIMIT_SECRET=replace-with-a-long-random-server-secret
